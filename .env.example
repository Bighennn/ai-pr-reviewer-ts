# GitHub App credentials (see docs/SETUP.md to obtain these).
# Probot reads these specific variable names automatically.
APP_ID=123456
PRIVATE_KEY_PATH=./github-app.private-key.pem
WEBHOOK_SECRET=replace-with-a-long-random-string

# For local development, Probot can manage the smee.io proxy for you.
# Paste your smee channel URL here and Probot connects to it on `npm run dev`.
WEBHOOK_PROXY_URL=https://smee.io/your-channel

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: set the HTTP port (default 3000)
PORT=3000

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
